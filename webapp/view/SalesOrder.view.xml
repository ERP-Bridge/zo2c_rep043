<mvc:View
    controllerName="zo2c_rep043.controller.SalesOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="_IDGenPage1"
        title="Sales Order Creation"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>
            <VBox
                id="_IDGenVBox"
                class="sapUiMediumMargin">

                <!-- Header -->
                <Toolbar id="_IDGenToolbar2">
                    <Button
                        id="_IDGenButton5"
                        text="Back"
                        icon="sap-icon://nav-back"
                        press=".onNavBack" />

                    <ToolbarSpacer id="_IDGenToolbarSpacer1" />

                    <Button
                        id="_IDGenButton6"
                        text="Mail to..."
                        icon="sap-icon://email" />

                    <Button
                        id="_IDGenButton7"
                        text="Print"
                        icon="sap-icon://print" />

                    <Button
                        id="_IDGenButton8"
                        text="Export As..."
                        icon="sap-icon://excel-attachment" />

                    <Button
                        id="_IDGenButton9"
                        text="Save"
                        icon="sap-icon://save"
                        press=".onSave" />

                    <Button
                        id="_IDGenButton10"
                        text="Confirm Sales Order"
                        type="Emphasized"
                        icon="sap-icon://accept"
                        press=".onConfirmSalesOrder" />
                </Toolbar>

                <!-- Profit Center -->
                <Panel
                    id="_IDGenPanel1"
                    class="sapUiMediumMarginTop">

                    <HBox
                        id="_IDGenHBox2"
                        justifyContent="SpaceBetween">

                        <VBox
                            id="_IDGenVBox6"
                            width="70%">

                            <Label
                                id="_IDGenLabel4"
                                text="Profit center" />

                            <Text
                                id="_IDGenText17"
                                text="{selectedQuotation>/profitCenter}" />
                        </VBox>

                        <VBox
                            id="_IDGenVBox7"
                            width="20%">

                            <Label
                                id="_IDGenLabel5"
                                text="Customer Approval" />

                            <Input
                                id="_IDGenInput"
                                value="{selectedQuotation>/approvalStatus}"
                                editable="false"
                                valueState="{selectedQuotation>/statusState}" />
                        </VBox>
                    </HBox>
                </Panel>

                <!-- Customer Section -->
                <Panel
                    id="_IDGenPanel2"
                    class="sapUiMediumMarginTop">

                    <VBox id="_IDGenVBox8">

                        <HBox
                            id="_IDGenHBox3"
                            justifyContent="SpaceBetween">

                            <VBox
                                id="_IDGenVBox9"
                                width="22%">

                                <Label
                                    id="_IDGenLabel6"
                                    text="Sold to customer" />

                                <Text
                                    id="_IDGenText19"
                                    text="{selectedQuotation>/soldToCustomer}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox10"
                                width="22%">

                                <Label
                                    id="_IDGenLabel7"
                                    text="Bill to customer" />

                                <Text
                                    id="_IDGenText20"
                                    text="{selectedQuotation>/billToCustomer}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox11"
                                width="22%">

                                <Label
                                    id="_IDGenLabel8"
                                    text="E-mail of contact" />

                                <Text
                                    id="_IDGenText21"
                                    text="{selectedQuotation>/contactEmail}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox25"
                                width="22%">

                                <Label
                                    id="_IDGenLabel9"
                                    text="EPM contract" />

                                <HBox
                                    id="_IDGenHBox4"
                                    justifyContent="SpaceBetween"
                                    alignItems="Center">

                                    <Text
                                        id="_IDGenText59"
                                        text="{selectedQuotation>/epmContract}" />

                                    <Button
                                        id="_IDGenButton11"
                                        icon="{
                                            path: 'uiModel>/customerDetailsVisible',
                                            formatter: '.formatEyeIcon'
                                        }"
                                        type="Emphasized"
                                        press=".onToggleCustomerDetails" />
                                </HBox>
                            </VBox>
                        </HBox>

                        <HBox
                            id="_IDGenHBox12"
                            justifyContent="SpaceBetween"
                            class="sapUiMediumMarginTop"
                            visible="{uiModel>/customerDetailsVisible}">

                            <VBox
                                id="_IDGenVBox26"
                                width="30%">

                                <Label
                                    id="_IDGenLabel15"
                                    text="Sold to:" />

                                <Text
                                    id="_IDGenText84"
                                    text="{selectedQuotation>/soldToName}" />

                                <Text
                                    id="_IDGenText85"
                                    text="{selectedQuotation>/soldToAddress}" />

                                <Text
                                    id="_IDGenText86"
                                    text="{selectedQuotation>/soldToCity}" />

                                <Text
                                    id="_IDGenText87"
                                    text="{selectedQuotation>/soldToVat}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox27"
                                width="30%">

                                <Label
                                    id="_IDGenLabel16"
                                    text="Bill to:" />

                                <Text
                                    id="_IDGenText88"
                                    text="{selectedQuotation>/billToName}" />

                                <Text
                                    id="_IDGenText89"
                                    text="{selectedQuotation>/billToAddress}" />

                                <Text
                                    id="_IDGenText90"
                                    text="{selectedQuotation>/billToCity}" />

                                <Text
                                    id="_IDGenText91"
                                    text="{selectedQuotation>/billToVat}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox28"
                                width="30%">

                                <Label
                                    id="_IDGenLabel17"
                                    text="Ship to:" />

                                <ComboBox
                                    id="_IDGenComboBox"
                                    width="100%"
                                    selectedKey="1"
                                    items="{selectedQuotation>/shipToOptions}">

                                    <core:Item
                                        key="{selectedQuotation>key}"
                                        text="{selectedQuotation>text}" />
                                </ComboBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </Panel>

                <!-- Additional Information -->
                <Panel
                    id="_IDGenPanel3"
                    headerText="Additional information :"
                    class="sapUiMediumMarginTop">

                    <TextArea
                        id="_IDGenTextArea"
                        width="100%"
                        rows="5"
                        value="{selectedQuotation>/additionalInfo}"
                        placeholder="Placeholder" />
                </Panel>

                <!-- Service Details -->
                <Panel
                    id="_IDGenPanel6"
                    class="sapUiMediumMarginTop">

                    <VBox id="_IDGenVBox12">

                        <HBox
                            id="_IDGenHBox5"
                            justifyContent="SpaceBetween">

                            <VBox
                                id="_IDGenVBox13"
                                width="14%">

                                <Label
                                    id="_IDGenLabel10"
                                    text="Service date from" />

                                <Text
                                    id="_IDGenText18"
                                    text="{selectedQuotation>/serviceDateFrom}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox14"
                                width="14%">

                                <Label
                                    id="_IDGenLabel11"
                                    text="Service date to" />

                                <Text
                                    id="_IDGenText22"
                                    text="{selectedQuotation>/serviceDateTo}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox15"
                                width="18%">

                                <Label
                                    id="_IDGenLabel12"
                                    text="Event Name" />

                                <Text
                                    id="_IDGenText23"
                                    text="{selectedQuotation>/eventName}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox16"
                                width="18%">

                                <Label
                                    id="_IDGenLabel13"
                                    text="Customer PO num" />

                                <Text
                                    id="_IDGenText24"
                                    text="{selectedQuotation>/customerPoNum}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox29"
                                width="12%">

                                <Label
                                    id="_IDGenLabel18"
                                    text="Currency" />

                                <Text
                                    id="_IDGenText25"
                                    text="{selectedQuotation>/currency}" />
                            </VBox>

                            <VBox
                                id="_IDGenVBox30"
                                width="5%">

                                <Button
                                    id="_IDGenButton12"
                                    icon="{
                                        path: 'uiModel>/serviceDetailsVisible',
                                        formatter: '.formatEyeIcon'
                                    }"
                                    type="Emphasized"
                                    press=".onToggleServiceDetails" />
                            </VBox>
                        </HBox>

                        <VBox
                            id="_IDGenVBox31"
                            class="sapUiMediumMarginTop"
                            visible="{uiModel>/serviceDetailsVisible}">

                            <Label
                                id="_IDGenLabel19"
                                text="Buyer reference" />

                            <Text
                                id="_IDGenText92"
                                text="{selectedQuotation>/buyerReference}" />
                        </VBox>
                    </VBox>
                </Panel>

                <!-- Attachments -->
                <Panel
                    id="_IDGenPanel5"
                    headerText="Attachments"
                    class="sapUiMediumMarginTop">

                    <VBox id="_IDGenVBox32">

                        <HBox
                            id="_IDGenHBox6"
                            justifyContent="End">

                            <Button
                                id="_IDGenButton13"
                                icon="{
                                    path: 'uiModel>/attachmentsVisible',
                                    formatter: '.formatEyeIcon'
                                }"
                                type="Emphasized"
                                press=".onToggleAttachments" />
                        </HBox>

                        <Text
                            id="_IDGenText93"
                            text="Select the documents you wish to share with your contacts."
                            class="sapUiSmallMarginTop"
                            visible="{uiModel>/attachmentsVisible}" />

                        <HBox
                            id="_IDGenHBox13"
                            justifyContent="SpaceBetween"
                            class="sapUiMediumMarginTop"
                            visible="{uiModel>/attachmentsVisible}">

                            <VBox
                                id="_IDGenVBox33"
                                width="55%"
                                items="{selectedQuotation>/attachments}">

                                <CheckBox
                                    text="{selectedQuotation>name}"
                                    selected="{selectedQuotation>selected}" />
                            </VBox>

                            <HBox
                                id="_IDGenHBox14"
                                width="40%">

                                <Input
                                    id="_IDGenInput7"
                                    value="Additional document.jpg"
                                    width="70%" />

                                <Button
                                    id="_IDGenButton21"
                                    icon="sap-icon://search" />

                                <Button
                                    id="_IDGenButton22"
                                    text="Upload"
                                    type="Emphasized" />
                            </HBox>
                        </HBox>
                    </VBox>
                </Panel>

                <!-- Items -->
                <Panel
                    id="_IDGenPanel7"
                    headerText="Items"
                    class="sapUiMediumMarginTop">

                    <Table
                        id="_IDGenTable"
                        inset="false"
                        items="{selectedQuotation>/items}">

                        <columns>
                            <Column
                                id="_IDGenColumn11"
                                width="14%">
                                <Text
                                    id="_IDGenText26"
                                    text="WBS" />
                            </Column>

                            <Column
                                id="_IDGenColumn12"
                                width="32%">
                                <Text
                                    id="_IDGenText27"
                                    text="Article" />
                            </Column>

                            <Column
                                id="_IDGenColumn13"
                                width="10%">
                                <Text
                                    id="_IDGenText28"
                                    text="Quantity" />
                            </Column>

                            <Column
                                id="_IDGenColumn14"
                                width="8%">
                                <Text
                                    id="_IDGenText29"
                                    text="Unit price" />
                            </Column>

                            <Column
                                id="_IDGenColumn15"
                                width="8%">
                                <Text
                                    id="_IDGenText30"
                                    text="Currency" />
                            </Column>

                            <Column
                                id="_IDGenColumn16"
                                width="8%">
                                <Text
                                    id="_IDGenText31"
                                    text="NetTotal" />
                            </Column>

                            <Column
                                id="_IDGenColumn17"
                                width="6%">
                                <Text
                                    id="_IDGenText32"
                                    text="VAT %" />
                            </Column>

                            <Column
                                id="_IDGenColumn18"
                                width="8%">
                                <Text
                                    id="_IDGenText33"
                                    text="Gross" />
                            </Column>

                            <Column
                                id="_IDGenColumn19"
                                width="8%">
                                <Text
                                    id="_IDGenText34"
                                    text="Actions" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem id="_IDGenColumnListItem1">
                                <cells>
                                    <VBox id="_IDGenVBox17">
                                        <Text
                                            id="_IDGenText35"
                                            text="{selectedQuotation>wbs}" />

                                        <Text
                                            id="_IDGenText36"
                                            text="{selectedQuotation>wbsDescription}" />
                                    </VBox>

                                    <VBox id="_IDGenVBox18">
                                        <Text
                                            id="_IDGenText37"
                                            text="{selectedQuotation>article}" />

                                        <Text
                                            id="_IDGenText38"
                                            text="{selectedQuotation>articleDescription}" />
                                    </VBox>

                                    <Input
                                        id="_IDGenInput1"
                                        value="{selectedQuotation>quantity}"
                                        width="4rem" />

                                    <Text
                                        id="_IDGenText39"
                                        text="{selectedQuotation>unitPrice}" />

                                    <Text
                                        id="_IDGenText40"
                                        text="{selectedQuotation>currency}" />

                                    <Text
                                        id="_IDGenText41"
                                        text="{selectedQuotation>netTotal}" />

                                    <Text
                                        id="_IDGenText42"
                                        text="{selectedQuotation>vat}" />

                                    <Text
                                        id="_IDGenText43"
                                        text="{selectedQuotation>gross}" />

                                    <HBox id="_IDGenHBox7">
                                        <Button
                                            id="_IDGenButton14"
                                            icon="sap-icon://delete"
                                            type="Transparent" />

                                        <Button
                                            id="_IDGenButton15"
                                            icon="sap-icon://copy"
                                            type="Transparent" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                    <HBox
                        id="_IDGenHBox11"
                        justifyContent="End">

                        <Button
                            id="_IDGenButton20"
                            text="Add item"
                            icon="sap-icon://add"
                            type="Transparent" />
                    </HBox>
                </Panel>

                <!-- Bottom Section -->
                <HBox
                    id="_IDGenHBox9"
                    justifyContent="SpaceBetween"
                    class="sapUiMediumMarginTop">

                    <VBox
                        id="_IDGenVBox21"
                        width="48%">

                        <Label
                            id="_IDGenLabel14"
                            text="Additional notes:" />

                        <TextArea
                            id="_IDGenTextArea1"
                            width="100%"
                            rows="6"
                            placeholder="Typed Text" />
                    </VBox>

                    <VBox
                        id="_IDGenVBox22"
                        width="48%">

                        <Table
                            id="_IDGenTable1"
                            inset="false"
                            fixedLayout="true"
                            items="{selectedQuotation>/totals}">

                            <columns>
                                <Column
                                    id="_IDGenColumn20"
                                    width="30%">
                                    <Text
                                        id="_IDGenText53"
                                        text="" />
                                </Column>

                                <Column
                                    id="_IDGenColumn21"
                                    width="25%">
                                    <Text
                                        id="_IDGenText54"
                                        text="Total net" />
                                </Column>

                                <Column
                                    id="_IDGenColumn22"
                                    width="15%">
                                    <Text
                                        id="_IDGenText55"
                                        text="VAT %" />
                                </Column>

                                <Column
                                    id="_IDGenColumn23"
                                    width="30%">
                                    <Text
                                        id="_IDGenText56"
                                        text="Total gross" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem id="_IDGenColumnListItem3">
                                    <cells>
                                        <Text
                                            id="_IDGenText58"
                                            text="{selectedQuotation>label}" />

                                        <Text
                                            id="_IDGenText57"
                                            text="{selectedQuotation>totalNet}" />

                                        <Text
                                            id="_IDGenText60"
                                            text="{selectedQuotation>vat}" />

                                        <Text
                                            id="_IDGenText61"
                                            text="{selectedQuotation>totalGross}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>