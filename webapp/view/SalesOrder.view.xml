                                        <core:Item
                                            id="_IDGenItem1"
                                            key="2"
                                            text="Name Address City" />

                                        <core:Item
                                            id="_IDGenItem2"
                                            key="3"
                                            text="Name Address City" />
                                    </items>
                                </ComboBox>
